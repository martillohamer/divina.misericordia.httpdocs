<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Emula Options -Indexes -->
    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>

        <!-- Redirect a no-www -->
        <rule name="Force non-www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.*)$" />
          </conditions>
          <action type="Redirect" url="http://{C:1}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Redirigir extensiones a .html (solo si NO hay querystring) -->
        <rule name="Extensions to .html (no querystring)" stopProcessing="true">
          <match url="(.*)\.(shtml|phtml|htm|php|aspx|asp|jsp)$" ignoreCase="true" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="^$" />
          </conditions>
          <action type="Redirect" url="{R:1}.html" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- Añadir barra final si no es archivo ni tiene extensión -->
        <rule name="Add trailing slash" stopProcessing="true">
          <match url=".+[^/]" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{URL}" pattern=".+\.[A-Za-z0-9]+$" negate="true" />
          </conditions>
          <action type="Redirect" url="{R:0}/" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Pretty URLs: /algo/  -> /algo.html (reescritura interna) -->
        <rule name="Pretty URLs to .html" stopProcessing="true">
          <match url="(.+)/" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" appendQueryString="true" />
        </rule>

        <!-- index.html -> / -->
        <rule name="Index html to root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Redirecciones por querystring en raíz: ?page_id=N o ?attachment_id=566 -->
        <!-- En IIS el path raíz es cadena vacía, por eso ^$ -->
        <rule name="QS page_id=4 to /page_id_4/" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="^page_id=4$" />
          </conditions>
          <action type="Redirect" url="page_id_4/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="QS page_id=6" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=6$" /></conditions><action type="Redirect" url="page_id_6/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=7" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=7$" /></conditions><action type="Redirect" url="page_id_7/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=8" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=8$" /></conditions><action type="Redirect" url="page_id_8/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=9" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=9$" /></conditions><action type="Redirect" url="page_id_9/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=10" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=10$" /></conditions><action type="Redirect" url="page_id_10/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=211" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=211$" /></conditions><action type="Redirect" url="page_id_211/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=213" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=213$" /></conditions><action type="Redirect" url="page_id_213/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=215" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=215$" /></conditions><action type="Redirect" url="page_id_215/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=217" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=217$" /></conditions><action type="Redirect" url="page_id_217/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=219" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=219$" /></conditions><action type="Redirect" url="page_id_219/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=221" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=221$" /></conditions><action type="Redirect" url="page_id_221/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=223" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=223$" /></conditions><action type="Redirect" url="page_id_223/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=225" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=225$" /></conditions><action type="Redirect" url="page_id_225/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=227" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=227$" /></conditions><action type="Redirect" url="page_id_227/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=230" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=230$" /></conditions><action type="Redirect" url="page_id_230/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=232" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=232$" /></conditions><action type="Redirect" url="page_id_232/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=234" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=234$" /></conditions><action type="Redirect" url="page_id_234/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=240" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=240$" /></conditions><action type="Redirect" url="page_id_240/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=244" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=244$" /></conditions><action type="Redirect" url="page_id_244/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=15" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=15$" /></conditions><action type="Redirect" url="page_id_15/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=13" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=13$" /></conditions><action type="Redirect" url="page_id_13/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=14" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=14$" /></conditions><action type="Redirect" url="page_id_14/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=163" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=163$" /></conditions><action type="Redirect" url="page_id_163/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=25" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=25$" /></conditions><action type="Redirect" url="page_id_25/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=19" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=19$" /></conditions><action type="Redirect" url="page_id_19/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=21" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=21$" /></conditions><action type="Redirect" url="page_id_21/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=22" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=22$" /></conditions><action type="Redirect" url="page_id_22/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=23" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=23$" /></conditions><action type="Redirect" url="page_id_23/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=24" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=24$" /></conditions><action type="Redirect" url="page_id_24/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=73" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=73$" /></conditions><action type="Redirect" url="page_id_73/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=16" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=16$" /></conditions><action type="Redirect" url="page_id_16/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=17" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=17$" /></conditions><action type="Redirect" url="page_id_17/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=20" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=20$" /></conditions><action type="Redirect" url="page_id_20/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=151" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=151$" /></conditions><action type="Redirect" url="page_id_151/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS attachment_id=566" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="^attachment_id=566$" />
          </conditions>
          <action type="Redirect" url="attachment_id_566/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="QS page_id=189" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=189$" /></conditions><action type="Redirect" url="page_id_189/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=192" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=192$" /></conditions><action type="Redirect" url="page_id_192/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=194" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=194$" /></conditions><action type="Redirect" url="page_id_194/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=196" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=196$" /></conditions><action type="Redirect" url="page_id_196/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=198" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=198$" /></conditions><action type="Redirect" url="page_id_198/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=200" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=200$" /></conditions><action type="Redirect" url="page_id_200/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=203" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=203$" /></conditions><action type="Redirect" url="page_id_203/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=206" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=206$" /></conditions><action type="Redirect" url="page_id_206/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=208" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=208$" /></conditions><action type="Redirect" url="page_id_208/" redirectType="Permanent" appendQueryString="false" /></rule>
        <rule name="QS page_id=11" stopProcessing="true"><match url="^$" /><conditions><add input="{QUERY_STRING}" pattern="^page_id=11$" /></conditions><action type="Redirect" url="page_id_11/" redirectType="Permanent" appendQueryString="false" /></rule>

        <!-- robots.txt -> /robots-txt/ -->
        <rule name="robots.txt redirect" stopProcessing="true">
          <match url="^robots\.txt$" />
          <action type="Redirect" url="robots-txt/" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Versión concreta de JS con ver=4.2.14 -->
        <rule name="cloudy.js ver 4.2.14 redirect" stopProcessing="true">
          <match url="^wp-content/themes/cloudy-blue-sky/cloudy\.js$" ignoreCase="true" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="^ver=4\.2\.14$" />
          </conditions>
          <action type="Redirect" url="wp-content/themes/cloudy-blue-sky/cloudy-js_ver_4-2-14/" redirectType="Permanent" appendQueryString="false" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
